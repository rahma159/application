   <string notr="true">/* Basic Styling - Enhance as needed */
QDialog {
    background-color: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:1, stop:0 #e0eafc, stop:1 #cfdef3); /* Light blue gradient */
}

QLabel {
    font-family: 'Segoe UI', sans-serif;
    font-size: 10pt;
    color: #333;
}

QLineEdit, QTimeEdit, QComboBox {
    background-color: #ffffff;
    border: 1px solid #ccc;
    border-radius: 4px;
    padding: 5px;
    font-size: 10pt;
}

QPushButton {
    background-color: #9B59B6; /* Purple */
    color: white;
    border: none;
    border-radius: 5px;
    padding: 8px 15px;
    font-size: 10pt;
    font-weight: bold;
}

QPushButton:hover {
    background-color: #8E44AD; /* Darker Purple */
}

QPushButton:pressed {
    background-color: #70308f;
}

QCalendarWidget QWidget#qt_calendar_navigationbar {
    background-color: #9B59B6; /* Purple */
}
QCalendarWidget QToolButton {
    color: white;
    font-size: 12pt;
    icon-size: 18px, 18px;
    background-color: transparent;
}
QCalendarWidget QMenu {
    background-color: white;
    color: #333;
}
QCalendarWidget QSpinBox {
     color: white;
     background-color: transparent;
     selection-background-color: #8E44AD;
     selection-color: white;
}
QCalendarWidget QTableView {
    selection-background-color: #8E44AD; /* Darker Purple for selection */
    selection-color: white;
}
/* Highlighted dates (set in code) */
QCalendarWidget QTableView::item:selected {
     background-color: #8E44AD;
     color: white;
}

QListWidget {
    background-color: #f8f8f8;
    border: 1px solid #ddd;
    border-radius: 4px;
}
</string>
